{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["iad1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/**,scripts/**,.cache/**,.venv/**,.claude/**,README.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
